# Portable Syncer configuration. Copy to .env on the PC, then fill these fields.
# .env stays inside the folder copied to the NAS and is ignored by Git.

# CalDAV server reachable from the NAS containers. For a Synology host, use
# http(s)://host.docker.internal:5000 or :5001 followed by /caldav.php/.
# From another host use the NAS hostname or LAN address.
CALDAV_URL=YOUR_VALUE_HERE
CALDAV_USERNAME=YOUR_VALUE_HERE
CALDAV_PASSWORD=YOUR_VALUE_HERE
# If CALDAV_URL names a service on this same NAS but Docker cannot resolve the
# NAS hostname, map that hostname to the Docker host gateway. The Compose file
# uses a non-resolving example hostname by default. Configure your hostname locally.
# CALDAV_HOST_ALIAS=caldav.example.invalid

# Google OAuth uses one Desktop app JSON in setup/google/client_secret.json.

# Spotify app credentials and the redirect URI registered for that app.
# Local browser authorization happens on the PC before copying the folder.
SPOTIFY_CLIENT_ID=YOUR_VALUE_HERE
SPOTIFY_CLIENT_SECRET=YOUR_VALUE_HERE
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9000/callback

# Todoist personal token: Settings -> Integrations -> Developer -> API token.
# Configure locally; never paste it into logs or commit it.
TODOIST_API_TOKEN=YOUR_VALUE_HERE

# Optional Telegram notifications for vdirsyncer errors and changed events.
# TELEGRAM_BOT_TOKEN=YOUR_VALUE_HERE
# TELEGRAM_CHAT_ID=YOUR_VALUE_HERE

# Optional schedules and backup retention. Defaults are also in the code/Compose.
# SYNC_INTERVAL_MINUTES=60
# SPOTIFY_BACKUP_SCHEDULE=0 */4 * * *
# TODOIST_BACKUP_SCHEDULE=0 */4 * * *
# TODOIST_MAX_REQUESTS=600
# TODOIST_MAX_RUN_SECONDS=1800
# TODOIST_HISTORY_WINDOWS=20
# CALDAV_BACKUP_INTERVAL_SECONDS=14400
# NAS: host networking avoids the Docker bridge source rejected by DSM.
# For another deployment, override with bridge and a reachable CALDAV_URL.
# CALDAV_BACKUP_NETWORK_MODE=host
# CALDAV_BACKUP_RETENTION=180
# CALDAV_BACKUP_TIMEOUT=60
# CALDAV_BACKUP_ATTEMPTS=5
# CALDAV_BACKUP_MAX_AGE=43200
# SPOTIFY_SNAPSHOT_RETENTION=14
# GOOGLE_CONTACTS_SNAPSHOT_RETENTION=14
# Set all three retention settings to 1 to keep only the current snapshot.
# VDIRSYNCER_RUN_STARTUP_SYNC=1
# VDIRSYNCER_RUN_SCHEDULE=1

# Notion: official API, no browser/session cookies. Keep credentials in ONE .env.
# PAT: Developer portal -> Personal access tokens -> Notion API capability.
# PATs expire (max 1 year); renew locally before expiry.
NOTION_PAT=
# Legacy internal integration token supported when NOTION_PAT is empty.
# NOTION_TOKEN=
NOTION_ROOTS=
# Optional coverage roots: page:YOUR_PAGE_ID,database:YOUR_DATABASE_ID
NOTION_BACKUP_INTERVAL_SECONDS=14400
NOTION_BACKUP_RETENTION=1
NOTION_BACKUP_MAX_AGE=43200
NOTION_MAX_FILE_BYTES=536870912
NOTION_MAX_REQUESTS=20000
NOTION_API_DELAY_SECONDS=0.75
NOTION_MEMORY_LIMIT=256m
# If objects disappear: inspect deletions/permissions before allowing removal.
NOTION_ALLOW_MISSING=0
