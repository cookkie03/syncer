# ═══════════════════════════════════════════════════════════
# syncer — environment configuration
# Copy this file to .env and fill ALL YOUR_VALUE_HERE fields
# before running `docker compose up -d`
# ═══════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────
# CALDAV-BACKUP — CalDAV server credentials
# ───────────────────────────────────────────────────────────

# Full URL of your CalDAV server (Synology Calendar).
#
# ── Running on the NAS itself (recommended) ──────────────────────────────────
# Use host.docker.internal so the container reaches DSM directly without going
# through the router. Hairpin NAT (public DDNS → same NAS) often doesn't work.
#
#   DSM HTTP  port: 5000  →  http://host.docker.internal:5000/caldav.php/
#   DSM HTTPS port: 5001  →  https://host.docker.internal:5001/caldav.php/
#
# ── Running on an external machine ───────────────────────────────────────────
#   https://yournas.synology.me/caldav.php/
#
CALDAV_URL=YOUR_VALUE_HERE
CALDAV_USERNAME=YOUR_VALUE_HERE
CALDAV_PASSWORD=YOUR_VALUE_HERE

# Static IP for the Synology DDNS hostname (avoids ISP DNS hijacking).
# Resolve via DoH: curl 'https://1.1.1.1/dns-query?name=yournas.synology.me&type=A' -H 'accept: application/dns-json'
SYNOLOGY_IP=YOUR_VALUE_HERE


# ───────────────────────────────────────────────────────────
# SPOTIFY-BACKUP — Spotify OAuth credentials
# ───────────────────────────────────────────────────────────

# OAuth app credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_VALUE_HERE
SPOTIFY_CLIENT_SECRET=YOUR_VALUE_HERE

# Redirect URI registered in your Spotify app settings.
# For local auth: http://127.0.0.1:9000/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9000/callback

# Backup interval in minutes (default: 1440 = daily)
# BACKUP_INTERVAL_MINUTES=1440


# ───────────────────────────────────────────────────────────
# DOCKER BUILD — target CPU architecture
# ───────────────────────────────────────────────────────────

# amd64 for Intel/AMD (Synology DS224+, most x86 PCs)
# arm64 for ARM-based NAS (Synology DS923+ and similar)
TARGETARCH=amd64
